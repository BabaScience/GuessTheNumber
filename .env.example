# ---------------------------------------------------------------------------
# Room storage
# ---------------------------------------------------------------------------
# Leave these unset and the game keeps rooms in the server's own memory. That
# is perfect for `npm run dev`, but on Vercel each serverless instance has its
# own memory, so two players can land on two instances and never see the same
# room. Set these for anything you actually want to play on.
#
# Easiest source: Vercel dashboard -> Storage -> Upstash Redis. Linking it adds
# KV_REST_API_URL and KV_REST_API_TOKEN to your project automatically, and the
# app picks them up with no code change.
#
# Upstash's own dashboard calls the same two values UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN; either pair works.

KV_REST_API_URL=
KV_REST_API_TOKEN=
